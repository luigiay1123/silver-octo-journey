<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Instant Blog</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,opsz,wght@0,18..144,300..900;1,18..144,300..900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/images/Favicon.png">
  <link rel="stylesheet" href="/css/styles.css">

</head>
<body>
  
<nav class="headnav">
  <div class="container">
    <div class="nav-contents">
      <form 
        <% if (posts.length === 0) { %>
        action="/" 
        <% } else { %>
        action="/view"
        <% } %>
        method="GET">
        <button class="home-btn" type="submit"><img src="/images/logo.png" alt="instant blog logo"></button>
      </form>
      <form action="/create" method="GET">
        <button class="confirm-btn" type="submit">Create Your Blog</button>
      </form>
    </div>
  </div>
</nav>